# HTTP-адрес Deltament. В Docker Compose переопределяется на 0.0.0.0:7000.
DELTAMENT_ADDR=127.0.0.1:2700

# PostgreSQL. Если не задано, берётся TELESRV_POSTGRES_DSN.
DELTAMENT_DATABASE_URL=postgres://telesrv:password@127.0.0.1:5432/telesrv?sslmode=disable

# Обязательный ключ AES-GCM для токенов приваток. Минимум 16 символов.
DELTAMENT_SECRET_KEY=change-me-to-a-long-random-secret

# Bearer-токен владельца для /api/admin/*. Пусто — админка выключена.
DELTAMENT_ADMIN_TOKEN=

# Новые приватки сразу попадают на витрину.
DELTAMENT_AUTO_APPROVE=true

# Бонус новым юзерам в DELTA. 0 — без бонуса.
DELTAMENT_WELCOME_BONUS=0

# CORS для отдельно развёрнутого фронта.
DELTAMENT_CORS_ORIGIN=

# Необязательно: отдавать фронт с диска вместо встроенного.
DELTAMENT_STATIC_DIR=

# Необязательно: привязать приватки из JSON-файла при старте.
DELTAMENT_SERVERS_FILE=

# Автопривязка локального DeltaGram через Admin API.
DELTAMENT_DEFAULT_SERVER_SLUG=deltagram
# единственный сервер, который показывает и использует маркет
DELTAMENT_PRIMARY_SERVER_SLUG=deltagram
DELTAMENT_DEFAULT_SERVER_NAME=DeltaGram
DELTAMENT_DEFAULT_SERVER_API_URL=http://127.0.0.1:2599
DELTAMENT_DEFAULT_SERVER_TOKEN=
DELTAMENT_DEFAULT_SERVER_STARS_PER_GRAM=0
DELTAMENT_DEFAULT_SERVER_CONTACT=
